# Optional Groq analysis. Keep both values server-side.
GROQ_API_KEY=your-groq-api-key
GROQ_MODEL=llama-3.3-70b-versatile

# Jupyter/Python schema-3 local COG service.
NAUTIKOS_DATA_ROOT=/home/jovyan/work/caspiansea/data-v2
NAUTIKOS_ALLOWED_ORIGINS=https://nautikos-caspian.vercel.app

# Copernicus Data Space S3 is used only by optional one-time archive tools.
CDSE_S3_ENDPOINT=https://eodata.dataspace.copernicus.eu
CDSE_S3_ACCESS_KEY=optional-cdse-s3-access-key
CDSE_S3_SECRET_KEY=optional-cdse-s3-secret-key

# Copernicus OAuth is used only by the one-time COG builder on Jupyter.
# Normal map viewing never sends requests to Copernicus.
CDSE_CLIENT_ID=your-copernicus-oauth-client-id
CDSE_CLIENT_SECRET=your-copernicus-oauth-client-secret

# Vercel/Next.js server route: Jupyter API with /v3/manifest.
NAUTIKOS_DATA_BACKEND=https://your-imagery-server.example

# Browser-visible imagery server for the detailed base image. Public by design.
NEXT_PUBLIC_NAUTIKOS_DATA_URL=https://your-imagery-server.example
